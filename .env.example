# The real LoopWear backend (see docs/BACKEND_API_SPEC.md). Public on
# purpose — it's a URL, not a secret, and client components need it too.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Google OAuth client ID (must match the backend's GOOGLE_CLIENT_ID). Not a
# secret. Leave blank to hide the "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="970544688309-74r2immevd8cluhe6p492pgdogm9qjld.apps.googleusercontent.com"
