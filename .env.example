# The real LoopWear backend (see docs/BACKEND_API_SPEC.md). Public on
# purpose — it's a URL, not a secret, and client components need it too.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Google OAuth client ID (must match the backend's GOOGLE_CLIENT_ID). Not a
# secret. Leave blank to hide the "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="970544688309-74r2immevd8cluhe6p492pgdogm9qjld.apps.googleusercontent.com"

# Stripe publishable key (must match the backend's STRIPE_SECRET_KEY account).
# Not a secret — publishable keys are meant for the browser. Used only for
# non-INR checkout; INR checkout goes through Razorpay, which needs no
# frontend key (the backend hands the checkout response its Razorpay key id).
# Leave blank to show a "not set up yet" message instead of a card form.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
